{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtConfiguration": {
    "SecretKey": "",
    "Issuer": "TodoApi",
    "Audience": "TodoApiClients",
    "ExpiresInMinutes": 60
  },
  "ForwardedHeaders": {
    "KnownProxies": [ "127.0.0.1", "::1" ],
    "KnownNetworks": [ "172.16.0.0/12", "fd00::/8" ]
  },
  "DatabaseConfiguration": {
    "Host": "localhost",
    "Port": 5433,
    "Database": "your_database",
    "Username": "your_username",
    "Password": "your_password"
  }
}
